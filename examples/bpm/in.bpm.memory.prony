units           lj
dimension       3
boundary        f f f
atom_style      bond

special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0
newton          on off
comm_modify     vel yes cutoff 2.6
lattice         fcc 1.0

read_data       data.strip nocoeff

region          leftedge block -15 -14 -2.5 2.5 -0.5 0.5
group           leftedge region leftedge

region          rightedge block 14 15 -2.5 2.5 -0.5 0.5
group           rightedge region rightedge

group           freestrip subtract all rightedge

mass            1 1.0

neighbor        1.0 bin
pair_style      bpm/spring
pair_coeff      1 1 1.0 1.0 1.0

bond_style      bpm/prony 1 overlay/pair no break no smooth no temp/shift yes
bond_coeff      1 0.05 0.04 0.0 prony.table KEY 0.0001

compute         nbond all nbond/atom
compute         tbond all reduce sum c_nbond

timestep        0.1
thermo_style    custom step ke pe pxx pyy pzz c_tbond
thermo          100
thermo_modify   lost ignore lost/bond ignore
dump            1 all custom 100 atomDump id x y z c_nbond
#dump           2 all local 100 brokenDump f_brkbond[1] f_brkbond[2] f_brkbond[3]
#dump_modify    2 header no

fix             1 freestrip nve
fix             2 leftedge setforce 0 0 0
fix             3 all viscous 0.05

# Stretch shape at high temperature
fix             4 rightedge move linear 0.005 NULL NULL
run             30000

unfix           1
unfix           2
unfix           4

fix             1 all nve

# Freeze shape
variable        shift_factor equal 1e5
fix             decreaseTemp all adapt 1 bond bpm/prony aT 1 v_shift_factor
run             15000

unfix           decreaseTemp

# Allow shape to relax
variable        shift_factor equal 5
fix             increaseTemp all adapt 1 bond bpm/prony aT 1 v_shift_factor
run             60000